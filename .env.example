# Local development only. Copy to .env and change these before sharing a database.
POSTGRES_DB=bayes
POSTGRES_USER=bayes
POSTGRES_PASSWORD=bayes
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://bayes:bayes@localhost:5432/bayes

# pgAdmin is a local development tool; it is never deployed with an application.
PGADMIN_DEFAULT_EMAIL=admin@bayes.local
PGADMIN_DEFAULT_PASSWORD=change-me-before-sharing
PGADMIN_PORT=5050

APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
